# Copy to .env and choose a Bedrock model available in your AWS account.
BEDROCK_GENERATION_MODEL=
AWS_REGION=us-east-1

# MLflow uses PostgreSQL for runs, traces, and Evaluation Datasets.
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=replace-with-a-local-development-password
MLFLOW_DB_NAME=mlflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Optional Phase 3 application database. This is separate from the MLflow database.
LINEAGE_DB_USER=lineage_app
LINEAGE_DB_PASSWORD=replace-with-a-local-development-password
LINEAGE_DB_NAME=consumer_finance_lineage
RAG__DATABASE__URL=postgresql+psycopg://lineage_app:replace-with-a-local-development-password@localhost:5433/consumer_finance_lineage

# Required only for optional billable LLM-as-a-judge evaluation.
# Never defaults to OpenAI. Bedrock form: bedrock:/<enabled-bedrock-model-id>
MLFLOW_GENAI_JUDGE_DEFAULT_MODEL=

# Optional configuration overrides. Nested keys use a double underscore.
# RAG__QDRANT__URL=http://localhost:6333
# RAG__QDRANT__COLLECTION_NAME=consumer_finance_phase1
# RAG__EVALUATION__QDRANT_COLLECTION_NAME=consumer_finance_evaluation
# RAG__EVALUATION__BM25_STATE_PATH=data/index/evaluation_bm25_state.json
# RAG__MODELS__EMBEDDING__MODEL=Qwen/Qwen3-Embedding-0.6B
# RAG__MODELS__EMBEDDING__QUERY_PROMPT_NAME=query
# RAG__MODELS__RERANKER__MODEL=Qwen/Qwen3-Reranker-0.6B
# RAG__AWS__CONNECT_TIMEOUT_SECONDS=5
# RAG__AWS__READ_TIMEOUT_SECONDS=120
# RAG__AWS__RETRY_MODE=standard
# RAG__AWS__TOTAL_MAX_ATTEMPTS=3
# RAG__AWS__TCP_KEEPALIVE=true
# RAG__MLFLOW__ENABLED=true
# RAG__MLFLOW__TRACKING_URI=http://localhost:5000
# RAG__MLFLOW__EXPERIMENT_NAME=consumer-finance-rag
# RAG__MLFLOW__EVALUATION_EXPERIMENT_NAME=consumer-finance-rag-evaluation
# RAG__MLFLOW__REPORT_DIRECTORY=reports/evaluation
